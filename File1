# Azure CLI commands to create a Virtual Machine
# Run these in Azure Cloud Shell or locally with Azure CLI installed

az login

# Create a resource group
az group create --name rg-demo --location eastus

# Create the VM
az vm create \
  --resource-group rg-demo \
  --name myvm01 \
  --image Ubuntu2204 \
  --admin-username azureuser \
  --generate-ssh-keys \
  --public-ip-sku Standard \
  --size Standard_B2s

# Optional: open port 80 for web traffic
az vm open-port --port 80 --resource-group rg-demo --name myvm01

# Connect to the VM using SSH
# ssh azureuser@<public-ip>
